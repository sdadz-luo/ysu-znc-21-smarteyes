CompileFlags:
  Add:
    # Target: MIMXRT1064DVL6A (cortex-m7)
    - "-target"
    - "arm-none-eabi"
    - "-mcpu=cortex-m7"
    - "-mthumb"
    - "-mfpu=fpv5-d16"
    - "-mfloat-abi=hard"

    # ARMCC v5 兼容模式
    - "-fms-extensions"
    - "-fdeclspec"

    # 项目自定义：欺骗 clangd 使用 GCC 兼容模式 / 取消 Windows 宏
    - "-D__GNUC__"
    - "-U_WIN32"

    # Preprocessor defines from Keil project
    - "-DCPU_MIMXRT1064DVL6A"
    - "-DSKIP_SYSCLK_INIT"
    - "-DXIP_EXTERNAL_FLASH=1"
    - "-DXIP_BOOT_HEADER_DCD_ENABLE=1"
    - "-DXIP_BOOT_HEADER_ENABLE=1"
    - "-DPRINTF_FLOAT_ENABLE=1"
    - "-DSCANF_FLOAT_ENABLE=1"
    - "-DPRINTF_ADVANCED_ENABLE=1"
    - "-DSCANF_ADVANCED_ENABLE=1"
    - "-DFSL_DRIVER_TRANSFER_DOUBLE_WEAK_IRQ=0"
    - "-DUSB_STACK_BM"
    - "-DDEBUG"
    - "-DMCUXPRESSO_SDK"
    - "-DSD_ENABLED"

    # Include paths
    - "-I"
    - "project/user/inc"
    - "-I"
    - "project/code"
    - "-I"
    - "libraries/sdk/startup/mdk"
    - "-I"
    - "libraries/sdk/deceive"
    - "-I"
    - "libraries/sdk/drives"
    - "-I"
    - "libraries/sdk/xip"
    - "-I"
    - "libraries/sdk/utilities"
    - "-I"
    - "libraries/sdk/utilities/debug_console"
    - "-I"
    - "libraries/sdk/utilities/str"
    - "-I"
    - "libraries/sdk/cmsis_drivers"
    - "-I"
    - "libraries/sdk/CMSIS/Include"
    - "-I"
    - "libraries/sdk/CMSIS/Driver/Include"
    - "-I"
    - "libraries/sdk/components/lists"
    - "-I"
    - "libraries/sdk/components/osa"
    - "-I"
    - "libraries/sdk/components/serial_manager"
    - "-I"
    - "libraries/sdk/components/uart"
    - "-I"
    - "libraries/sdk/board"
    - "-I"
    - "libraries/components/fatfs/source"
    - "-I"
    - "libraries/components/fatfs/source/fsl_sd_disk"
    - "-I"
    - "libraries/components/sdmmc"
    - "-I"
    - "libraries/components/sdmmc/common"
    - "-I"
    - "libraries/components/sdmmc/host/usdhc"
    - "-I"
    - "libraries/components/sdmmc/osa"
    - "-I"
    - "libraries/components/sdmmc/sd"
    - "-I"
    - "libraries/components/usb/device"
    - "-I"
    - "libraries/components/usb/include"
    - "-I"
    - "libraries/components/usb/phy"
    - "-I"
    - "libraries/components/usb/usb_cdc_adapter"
    - "-I"
    - "libraries/zf_common"
    - "-I"
    - "libraries/zf_driver"
    - "-I"
    - "libraries/zf_device"
    - "-I"
    - "libraries/zf_components"

    # 项目自定义：禁止系统头文件（使用逐飞库 stub）
    - "-nostdinc"

    # C standard
    - "-std=c99"
